{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://207.180.201.199:8080/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://207.180.201.199:8080/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
