# ==========================================
# EOS Deployment Environment Configuration
# ==========================================

# Ports exposed on host
FRONTEND_PORT=5173
BACKEND_PORT=5000
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_change_me
POSTGRES_DB=eos_church

# Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_string
JWT_EXPIRES_IN=7d

# MinIO Object Storage
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_change_me
MINIO_BUCKET=eos-members

# Frontend build-time API base URL (empty defaults to same host / relative path)
VITE_API_BASE_URL=
